rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }

    function isMember(lid) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/lists/$(lid)).data.members;
    }

    // Diretório de e-mails cadastrados. Só dá para consultar um e-mail específico (get);
    // listar todos é bloqueado. Cada pessoa só registra o próprio e-mail, já confirmado.
    match /userDirectory/{em} {
      allow get: if verified();
      allow list: if false;
      allow create, update: if verified()
        && em == request.auth.token.email.lower()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == em;
      allow delete: if false;
    }

    match /lists/{lid} {
      // Criar lista: quem cria é o dono e o único membro inicial.
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.invitedEmails == [];

      // Ler: membros, ou quem recebeu convite (com e-mail confirmado).
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow read: if verified() && request.auth.token.email in resource.data.invitedEmails;

      // Membros editam título, dia e participantes (convidar, remover, sair). O dono não muda.
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['title', 'date', 'members', 'memberEmails', 'invitedEmails']);

      // Convidado aceita: só entra em members/memberEmails e sai de invitedEmails.
      allow update: if verified()
        && request.auth.token.email in resource.data.invitedEmails
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['members', 'memberEmails', 'invitedEmails'])
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.members.hasAll(resource.data.members)
        && request.auth.uid in request.resource.data.members;

      // Convidado recusa: só remove o próprio e-mail dos convites.
      allow update: if verified()
        && request.auth.token.email in resource.data.invitedEmails
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invitedEmails'])
        && !(request.auth.token.email in request.resource.data.invitedEmails)
        && request.resource.data.invitedEmails.size() == resource.data.invitedEmails.size() - 1;

      // Só o dono exclui a lista.
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      // Itens: só membros da lista.
      match /items/{iid} {
        allow read, write: if isMember(lid);
      }
    }
  }
}
